# Copy to .env and fill in real values. Never commit the filled-in file.
# This file must contain NO real secrets.

# ---------- Core ----------
PORT=5000
FRONTEND_URL=http://localhost:4200
JWT_SECRET=replace-with-a-long-random-string

# ---------- Database (MongoDB Atlas) ----------
# Your Atlas SRV connection string, with the password URL-encoded.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=smart-hypermarket
# Some networks refuse SRV queries against the OS resolver; list resolvers here.
DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------- Email (password reset) ----------
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ---------- Social login: Google ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorised redirect / origin URIs must include your frontend origin, e.g.
#   http://localhost:4200
#   https://your-domain.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Social login: Facebook ----------
# Meta for Developers -> your app -> App settings -> Basic
# "Valid OAuth Redirect URIs" must include the same frontend origin, e.g.
#   http://localhost:4200
# FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- InstaPay (payment proof verification) ----------
INSTAPAY_ACCOUNT_NAME=
INSTAPAY_ACCOUNT_ID=
INSTAPAY_ACCOUNT_NUMBER=
INSTAPAY_BANK_NAME=
